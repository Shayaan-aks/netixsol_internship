# Stage 1: Build the React frontend using Vite
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Stage 2: We just output the files into a volume or a minimal image,
# but since Nginx serves this in docker-compose, we can just use an nginx image 
# and copy files to it, or let the main nginx container map the volume.
# For simplicity, we will copy the built files into an alpine container that 
# just sleeps or provides a volume, OR we can directly serve it using nginx here.
# Let's serve it using nginx and we can route to it from the main proxy if needed,
# OR just let this container be the frontend server.
FROM nginx:1.25-alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
