# ─── Required ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Optional — Path overrides ────────────────────────────────────────────────
# If deploying to Docker, override this path to the mounted agent directory
# DAY5_AGENT_PATH=/app/day5_agent

# ─── Optional — Google Calendar ───────────────────────────────────────────────
# GOOGLE_CREDENTIALS_PATH=/app/credentials.json
# GOOGLE_CALENDAR_ID=primary

# ─── Optional — Email (n8n webhook) ──────────────────────────────────────────
# N8N_WEBHOOK_URL=https://shayaanshahid.app.n8n.cloud/webhook/real-estate

# ─── Optional — CRM Database ─────────────────────────────────────────────────
# CRM_DB_URL=sqlite:///./test.db
# or for Supabase:
# CRM_DB_URL=postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres

# ─── Optional — Monitoring ────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# PROMETHEUS_PORT=9090
# GRAFANA_ADMIN_PASSWORD=admin123
